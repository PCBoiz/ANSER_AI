# deploy/.env.example — chép thành .env rồi điền.
#
#     cp .env.example .env
#
# ⚠️ .env chứa bí mật thật. KHÔNG commit. Kiểm tra .gitignore trước khi làm gì khác.

# --------------------------------------------------------------------------
# Model
# --------------------------------------------------------------------------
# Thư mục con trong MODELS_DIR chứa model text đã quantize (AWQ).
# Chép từ Drive xuống máy thuê: ANSER_AI_Logistics/anser-v3-awq
TEXT_MODEL_DIR=anser-v3-awq
MODELS_DIR=./models

# Cửa sổ ngữ cảnh. 32768 từ 28/10/2026 (BR-04, chủ dự án chốt): S2 đòi ctx 32k
# cho vòng agentic nạp lại kết quả tool mỗi bước. Đo trên L4: dựng được cùng
# vision, và nâng từ 8192 lên 32768 không làm request ngắn chạy kém song song —
# vLLM cấp KV theo token thật dùng. Xem BAO_CAO_BR04.md. config.py cùng mặc định.
TEXT_MAX_MODEL_LEN=32768

# Phần VRAM cho server text. Trên L4 22,5GB: 0.62 ≈ 14GB
# (weights AWQ ~6GB + KV-cache ~8GB). Còn ~20% cho vision, ~18% cho hệ thống.
TEXT_GPU_FRACTION=0.62

# --------------------------------------------------------------------------
# Vision (Giai đoạn 3b — chỉ dùng khi chạy `--profile vision`)
# --------------------------------------------------------------------------
VISION_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
VISION_MAX_MODEL_LEN=4096
VISION_GPU_FRACTION=0.20

# --------------------------------------------------------------------------
# Điều tiết tải — PHẢI đo lại trên máy thật (README §5)
# --------------------------------------------------------------------------
# 4 là điểm khởi đầu thận trọng, KHÔNG phải con số đã đo. Số đúng phụ thuộc
# KV-cache còn trống, mà cái đó phụ thuộc độ dài prompt thực tế.
TEXT_MAX_CONCURRENT=4
TEXT_MAX_QUEUE=16
TEXT_WAIT_TIMEOUT_S=20

# --------------------------------------------------------------------------
# Bí mật
# --------------------------------------------------------------------------
# Token Body dùng để gọi Brain. Sinh bằng: openssl rand -hex 32
API_TOKEN=

# Khoá giữa Brain và vLLM. Hai server chỉ nghe trên 127.0.0.1 nên có thể để
# trống; điền nếu sau này tách sang máy khác.
VLLM_API_KEY=

# Postgres (Neon). Để trống thì Brain chạy SQLite in-memory.
DATABASE_URL=

# Token tunnel: Cloudflare Zero Trust > Networks > Tunnels > tạo tunnel > copy token.
CLOUDFLARE_TUNNEL_TOKEN=
